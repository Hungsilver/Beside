// =========================================================
// Beside — Prisma schema
// Nguồn sự thật về mô hình dữ liệu: ARCHITECTURE.md §6
// Sửa file này thì PHẢI cập nhật ARCHITECTURE.md §6 tương ứng.
// =========================================================

generator client {
  provider = "prisma-client-js"
}

// Các extension (postgis, unaccent, uuid-ossp) được tạo sẵn bởi
// infra/postgres/init/01-extensions.sql, KHÔNG khai báo ở đây để
// prisma migrate không cần quyền superuser.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// Enum
// ---------------------------------------------------------

enum MessagingApp {
  ZALO
  MESSENGER
  PHONE
  SMS
}

enum LocSource {
  LIVE // Live Session, app đang mở
  PING // ping bị động khi mở app
  CHECKIN // toạ độ đính kèm bài check-in
}

enum EventVisibility {
  SHARED
  PRIVATE
}

enum MilestoneKind {
  AUTO_DAYS
  ANNIVERSARY
  BIRTHDAY
  CUSTOM
}

enum GeofenceEventType {
  ARRIVED
  LEFT
}

// ---------------------------------------------------------
// Người dùng & ghép đôi
// ---------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  phone        String?   @unique
  passwordHash String?
  displayName  String
  avatarUrl    String?
  birthday     DateTime? @db.Date

  // F9 — nút deep-link nhắn tin (không có chat trong app), xem §7.3
  messagingApp    MessagingApp @default(ZALO)
  messagingHandle String?

  // {ghostMode: boolean, shareLive: boolean, fuzzRadiusM: number}
  privacy Json @default("{\"ghostMode\":false,\"shareLive\":true,\"fuzzRadiusM\":0}")

  coupleId String?
  couple   Couple? @relation(fields: [coupleId], references: [id], onDelete: SetNull)

  refreshTokens  RefreshToken[]
  pushSubs       PushSubscription[]
  posts          Post[]
  createdEvents  Event[]
  locationPoints LocationPoint[]
  geofenceEvents GeofenceEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coupleId])
  @@map("users")
}

model Couple {
  id String @id @default(uuid())

  /// Mã mời KHÔNG bị xoá sau khi ghép xong — giữ lại để phân biệt
  /// "mã sai" với "mã đúng nhưng đã có người ghép trước rồi".
  inviteCode      String?   @unique
  inviteExpiresAt DateTime?

  /// Chốt chặn chống race: thời điểm mã được "giành" thành công.
  /// Chỉ đúng MỘT giao dịch đổi được cột này từ NULL sang có giá trị,
  /// nên hai người bấm "Kết đôi" cùng lúc thì chỉ một người vào được.
  inviteConsumedAt DateTime?

  anniversaryAt DateTime @db.Date

  members        User[]
  places         Place[]
  posts          Post[]
  events         Event[]
  milestones     Milestone[]
  locationPoints LocationPoint[]
  geofenceEvents GeofenceEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("couples")
}

// ---------------------------------------------------------
// Phiên đăng nhập
// ---------------------------------------------------------

/// Refresh token có xoay vòng (rotation) + phát hiện tái sử dụng.
/// Chỉ lưu SHA-256 của token, không bao giờ lưu token gốc.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  /// Cùng một chuỗi xoay vòng dùng chung familyId. Nếu một token cũ bị dùng lại
  /// → coi như bị đánh cắp → thu hồi cả family.
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedById String?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------
// Vị trí (Phase 2)
// ---------------------------------------------------------

model LocationPoint {
  id         BigInt    @id @default(autoincrement())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupleId   String
  couple     Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  accuracyM  Float
  speedMps   Float?
  headingDeg Float?
  battery    Int?
  source     LocSource
  recordedAt DateTime
  createdAt  DateTime  @default(now())

  /// Cột GENERATED của Postgres, tự tính từ lat/lng — xem migration
  /// 20260907160000_add_location_geography. Prisma không hiểu kiểu geography
  /// nên khai báo Unsupported(): client không đọc/ghi cột này, mọi truy vấn
  /// không gian đều đi qua $queryRaw.
  geog Unsupported("geography(Point, 4326)")?

  @@index([coupleId, recordedAt])
  /// Truy vấn vệt đường luôn lấy điểm mới nhất trước → sắp xếp giảm dần
  /// ngay trong chỉ mục để không phải sort lại.
  @@index([userId, recordedAt(sort: Desc)])
  /// Chỉ mục không gian cho ST_DWithin / ST_Distance (geofence ở Phase 4).
  @@index([geog], type: Gist)
  @@map("location_points")
}

model Place {
  id             String  @id @default(uuid())
  coupleId       String
  couple         Couple  @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  name           String
  emoji          String  @default("📍")
  lat            Float
  lng            Float
  radiusM        Int     @default(150)
  notifyOnArrive Boolean @default(true)
  notifyOnLeave  Boolean @default(false)

  geofenceEvents GeofenceEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coupleId])
  @@map("places")
}

model GeofenceEvent {
  id        String            @id @default(uuid())
  coupleId  String
  couple    Couple            @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId   String
  place     Place             @relation(fields: [placeId], references: [id], onDelete: Cascade)
  type      GeofenceEventType
  occurredAt DateTime

  @@index([coupleId, occurredAt])
  @@map("geofence_events")
}

// ---------------------------------------------------------
// Check-in & kỷ niệm (Phase 3)
// ---------------------------------------------------------

model Post {
  id        String   @id @default(uuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  caption   String?
  mood      String?
  lat       Float?
  lng       Float?
  placeName String?
  reactions Json     @default("[]")
  photos    Photo[]
  createdAt DateTime @default(now())

  @@index([coupleId, createdAt])
  @@map("posts")
}

model Photo {
  id       String @id @default(uuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  keyOrig  String
  keyMd    String
  keyThumb String
  width     Int
  height    Int
  /// Ảnh 20px nhúng thẳng dạng data URI, hiện trong lúc ảnh thật đang tải.
  /// Trước đây tên là `blurhash`, nhưng đây không phải thuật toán BlurHash —
  /// đổi tên cho khớp bản chất, xem migration 20260907190000.
  placeholder String
  sortOrder Int   @default(0)

  @@index([postId])
  @@map("photos")
}

// ---------------------------------------------------------
// Lịch trình & cột mốc (Phase 4)
// ---------------------------------------------------------

model Event {
  id              String          @id @default(uuid())
  coupleId        String
  couple          Couple          @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  title           String
  note            String?
  /// Emoji hiển thị trên dòng lịch. Mặc định 📅 khi người dùng không chọn.
  emoji           String          @default("📅")
  startAt         DateTime
  endAt           DateTime?
  allDay          Boolean         @default(false)
  placeId         String?
  lat             Float?
  lng             Float?
  remindMinBefore Int?            @default(60)
  visibility      EventVisibility @default(SHARED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([coupleId, startAt])
  @@map("events")
}

model Milestone {
  id       String        @id @default(uuid())
  coupleId String
  couple   Couple        @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  title    String
  date     DateTime      @db.Date
  kind     MilestoneKind
  emoji    String        @default("💖")

  @@index([coupleId, date])
  @@map("milestones")
}
