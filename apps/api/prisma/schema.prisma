// =========================================================
// Beside — Prisma schema
// Nguồn sự thật về mô hình dữ liệu: ARCHITECTURE.md §6
// Sửa file này thì PHẢI cập nhật ARCHITECTURE.md §6 tương ứng.
// =========================================================

generator client {
  provider = "prisma-client-js"
}

// Các extension (postgis, unaccent, uuid-ossp) được tạo sẵn bởi
// infra/postgres/init/01-extensions.sql, KHÔNG khai báo ở đây để
// prisma migrate không cần quyền superuser.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// Enum
// ---------------------------------------------------------

enum MessagingApp {
  ZALO
  MESSENGER
  PHONE
  SMS
}

enum LocSource {
  LIVE // Live Session, app đang mở
  PING // ping bị động khi mở app
  CHECKIN // toạ độ đính kèm bài check-in
}

enum EventVisibility {
  SHARED
  PRIVATE
}

enum MilestoneKind {
  AUTO_DAYS
  ANNIVERSARY
  BIRTHDAY
  CUSTOM
}

enum GeofenceEventType {
  ARRIVED
  LEFT
}

enum GameKind {
  TIEN_LEN
  CARO
}

enum GameStatus {
  PLAYING
  FINISHED
  ABANDONED // bỏ dở quá lâu, xem ABANDON_AFTER_MS
}

enum StudyPhase {
  FOCUS
  BREAK
}

enum StudyStatus {
  RUNNING
  DONE
  CANCELLED
}

// ---------------------------------------------------------
// Người dùng & ghép đôi
// ---------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  phone        String?   @unique
  passwordHash String?
  displayName  String
  birthday     DateTime? @db.Date

  /// Định danh của ảnh đại diện đang dùng. Khoá lưu trữ suy ra từ đây:
  /// `avatars/{avatarId}/{md|thumb}.webp`. Mỗi lần đổi ảnh sinh id mới nên
  /// URL cũng đổi theo — nhờ vậy trình duyệt không giữ ảnh cũ trong cache.
  avatarId String? @db.Uuid
  /// Vài dòng tự giới thiệu.
  bio      String?
  /// Địa chỉ người dùng TỰ GÕ. Không geocode, không dính tới hệ thống vị trí.
  address  String?

  // F9 — nút deep-link nhắn tin (không có chat trong app), xem §7.3
  messagingApp    MessagingApp @default(ZALO)
  messagingHandle String?

  // {ghostMode: boolean, shareLive: boolean, fuzzRadiusM: number}
  privacy Json @default("{\"ghostMode\":false,\"shareLive\":true,\"fuzzRadiusM\":0}")

  coupleId String?
  couple   Couple? @relation(fields: [coupleId], references: [id], onDelete: SetNull)

  refreshTokens  RefreshToken[]
  pushSubs       PushSubscription[]
  posts          Post[]
  comments       Comment[]
  createdEvents  Event[]
  gameTurns      Game[]     @relation("GameTurn")
  gameWins       Game[]     @relation("GameWinner")
  gameMoves      GameMove[]
  studyStarted   StudySession[] @relation("StudyStarter")
  studyLogs      StudyLog[]
  locationPoints LocationPoint[]
  geofenceEvents GeofenceEvent[]
  geofenceStates GeofenceState[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coupleId])
  @@map("users")
}

model Couple {
  id String @id @default(uuid())

  /// Mã mời KHÔNG bị xoá sau khi ghép xong — giữ lại để phân biệt
  /// "mã sai" với "mã đúng nhưng đã có người ghép trước rồi".
  inviteCode      String?   @unique
  inviteExpiresAt DateTime?

  /// Chốt chặn chống race: thời điểm mã được "giành" thành công.
  /// Chỉ đúng MỘT giao dịch đổi được cột này từ NULL sang có giá trị,
  /// nên hai người bấm "Kết đôi" cùng lúc thì chỉ một người vào được.
  inviteConsumedAt DateTime?

  anniversaryAt DateTime @db.Date

  members        User[]
  places         Place[]
  posts          Post[]
  events         Event[]
  milestones     Milestone[]
  games          Game[]
  studySessions  StudySession[]
  studyLogs      StudyLog[]
  locationPoints LocationPoint[]
  geofenceEvents GeofenceEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("couples")
}

// ---------------------------------------------------------
// Phiên đăng nhập
// ---------------------------------------------------------

/// Refresh token có xoay vòng (rotation) + phát hiện tái sử dụng.
/// Chỉ lưu SHA-256 của token, không bao giờ lưu token gốc.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  /// Cùng một chuỗi xoay vòng dùng chung familyId. Nếu một token cũ bị dùng lại
  /// → coi như bị đánh cắp → thu hồi cả family.
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedById String?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------
// Vị trí (Phase 2)
// ---------------------------------------------------------

model LocationPoint {
  id         BigInt    @id @default(autoincrement())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupleId   String
  couple     Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  accuracyM  Float
  speedMps   Float?
  headingDeg Float?
  battery    Int?
  source     LocSource
  recordedAt DateTime
  createdAt  DateTime  @default(now())

  /// Cột GENERATED của Postgres, tự tính từ lat/lng — xem migration
  /// 20260907160000_add_location_geography. Prisma không hiểu kiểu geography
  /// nên khai báo Unsupported(): client không đọc/ghi cột này, mọi truy vấn
  /// không gian đều đi qua $queryRaw.
  geog Unsupported("geography(Point, 4326)")?

  @@index([coupleId, recordedAt])
  /// Truy vấn vệt đường luôn lấy điểm mới nhất trước → sắp xếp giảm dần
  /// ngay trong chỉ mục để không phải sort lại.
  @@index([userId, recordedAt(sort: Desc)])
  /// Chỉ mục không gian cho ST_DWithin / ST_Distance (geofence ở Phase 4).
  @@index([geog], type: Gist)
  @@map("location_points")
}

model Place {
  id             String  @id @default(uuid())
  coupleId       String
  couple         Couple  @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  name           String
  emoji          String  @default("📍")
  lat            Float
  lng            Float
  radiusM        Int     @default(150)
  notifyOnArrive Boolean @default(true)
  notifyOnLeave  Boolean @default(false)

  geofenceEvents GeofenceEvent[]
  geofenceStates GeofenceState[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coupleId])
  @@map("places")
}

/// Trạng thái hiện tại của một người với một hàng rào.
///
/// Cần bảng riêng chứ không suy từ GeofenceEvent gần nhất: mỗi điểm vị trí gửi
/// lên đều phải trả lời "đang ở trong hay ngoài", mà truy vấn "sự kiện mới nhất
/// theo từng địa điểm" là một câu khó và tốn. Bảng này chỉ vài dòng mỗi người.
model GeofenceState {
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId String
  place   Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  inside  Boolean @default(false)
  /// Lần đầu thấy điểm nằm trong hàng rào của lượt vào này.
  /// Phải ở đủ lâu (GEOFENCE_MIN_DWELL_MS) mới tính là đã tới nơi — đi xe ngang
  /// qua nhà thì không phải là về tới nhà.
  candidateSince DateTime?
  updatedAt      DateTime @updatedAt

  @@id([userId, placeId])
  @@map("geofence_states")
}

model GeofenceEvent {
  id        String            @id @default(uuid())
  coupleId  String
  couple    Couple            @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId   String
  place     Place             @relation(fields: [placeId], references: [id], onDelete: Cascade)
  type      GeofenceEventType
  occurredAt DateTime

  @@index([coupleId, occurredAt])
  @@map("geofence_events")
}

// ---------------------------------------------------------
// Check-in & kỷ niệm (Phase 3)
// ---------------------------------------------------------

model Post {
  id        String   @id @default(uuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  caption   String?
  mood      String?
  lat       Float?
  lng       Float?
  placeName String?
  reactions Json      @default("[]")
  photos    Photo[]
  comments  Comment[]
  createdAt DateTime  @default(now())

  @@index([coupleId, createdAt])
  @@map("posts")
}

model Photo {
  id       String @id @default(uuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  keyOrig  String
  keyMd    String
  keyThumb String
  width     Int
  height    Int
  /// Ảnh 20px nhúng thẳng dạng data URI, hiện trong lúc ảnh thật đang tải.
  /// Trước đây tên là `blurhash`, nhưng đây không phải thuật toán BlurHash —
  /// đổi tên cho khớp bản chất, xem migration 20260907190000.
  placeholder String
  sortOrder Int   @default(0)

  @@index([postId])
  @@map("photos")
}

/// Bình luận trong một khoảnh khắc.
///
/// Không phải chat (F9): mỗi dòng luôn gắn với đúng một `Post`, không có phòng
/// riêng, không có trạng thái đã xem. Quyền đọc/ghi suy ra từ `post.coupleId`
/// nên bảng này KHÔNG lặp lại cột `coupleId` — một nguồn sự thật duy nhất,
/// không có chỗ để hai cột lệch nhau.
model Comment {
  id       String @id @default(uuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body     String

  createdAt DateTime @default(now())

  /// Luôn đọc theo bài, sắp xếp cũ → mới.
  @@index([postId, createdAt])
  @@map("comments")
}

// ---------------------------------------------------------
// Lịch trình & cột mốc (Phase 4)
// ---------------------------------------------------------

model Event {
  id              String          @id @default(uuid())
  coupleId        String
  couple          Couple          @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  title           String
  note            String?
  /// Emoji hiển thị trên dòng lịch. Mặc định 📅 khi người dùng không chọn.
  emoji           String          @default("📅")
  startAt         DateTime
  endAt           DateTime?
  allDay          Boolean         @default(false)
  placeId         String?
  lat             Float?
  lng             Float?
  remindMinBefore Int?            @default(60)
  visibility      EventVisibility @default(SHARED)
  /// Đã gửi nhắc lịch lúc nào. NULL = chưa gửi.
  /// Đổi giờ sự kiện thì đặt lại về NULL để được nhắc theo giờ mới.
  reminderSentAt  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([coupleId, startAt])
  /// Chỉ mục cho job nhắc lịch: quét theo startAt trong đám chưa gửi.
  @@index([reminderSentAt, startAt])
  @@map("events")
}

model Milestone {
  id       String        @id @default(uuid())
  coupleId String
  couple   Couple        @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  title    String
  /// Ngày trôi nổi (§6.3): "kỷ niệm 11/11" là một ô trên tờ lịch, không phải
  /// một khoảnh khắc — nên lưu kiểu Date, không kèm múi giờ.
  date     DateTime      @db.Date
  kind     MilestoneKind
  emoji    String        @default("💖")
  /// Lặp lại hằng năm (mặc định) hay chỉ xảy ra đúng một lần.
  /// Mốc một lần đã qua thì biến mất khỏi danh sách "sắp tới".
  yearly   Boolean       @default(true)
  createdAt DateTime     @default(now())

  @@index([coupleId, date])
  @@map("milestones")
}

// ---------------------------------------------------------
// Trò chơi cho hai người (Phase 6) — docs/thiet-ke-games.md
// ---------------------------------------------------------

/// Một ván chơi. Toàn bộ diễn biến nằm trong `state` (JSON).
///
/// Cố tình KHÔNG tách bảng riêng cho bài và bàn cờ: hai game có hình dạng dữ
/// liệu khác hẳn nhau, ép chung một lược đồ quan hệ chỉ đẻ ra một bảng đầy cột
/// NULL mà không truy vấn nào dùng tới.
model Game {
  id       String     @id @default(uuid())
  coupleId String
  couple   Couple     @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  kind     GameKind
  status   GameStatus @default(PLAYING)

  /// Trạng thái ván. Với Tiến lên, cột này CHỨA BÀI TRÊN TAY CẢ HAI NGƯỜI —
  /// không bao giờ được trả thẳng ra client, phải đi qua bộ lọc theo người xem.
  state Json

  turnUserId String?
  turnUser   User?   @relation("GameTurn", fields: [turnUserId], references: [id], onDelete: SetNull)

  /// Mốc hết giờ của lượt hiện tại. NULL = đồng hồ đang TẠM DỪNG vì người tới
  /// lượt không mở app (iOS treo JS khi khoá màn hình — ARCHITECTURE.md §1.3).
  turnDeadlineAt DateTime?
  /// Còn lại bao nhiêu mili-giây khi tạm dừng; chạy tiếp thì cộng từ đây.
  turnRemainingMs Int @default(30000)

  /// Nước đi gần nhất. Quá ABANDON_AFTER_MS không ai đi thì cron huỷ ván.
  /// KHÔNG dùng `updatedAt` thay: tạm dừng đồng hồ cũng là một lần ghi, nên
  /// `updatedAt` sẽ tự đẩy hạn huỷ ra xa mỗi lần người dùng khoá màn hình.
  lastMoveAt DateTime @default(now())
  /// Nước đi gần nhất do đồng hồ tự sinh, không phải người bấm.
  lastMoveAuto Boolean @default(false)

  winnerId String?
  winner   User?   @relation("GameWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  /// HET_BAI | DU_QUAN | HET_GIO | DAU_HANG | HOA | BO_DO
  endReason String?

  /// Khoá lạc quan chống hai người bấm cùng lúc. Mỗi nước đi ghi kèm
  /// `WHERE version = <giá trị vừa đọc>`; không đổi được dòng nào nghĩa là có
  /// người đi trước rồi. Dùng lại bài học của ADR ghép đôi: KHÔNG dùng
  /// transaction Serializable, nó làm bên thua cuộc trả 500 vì hết maxWait.
  version Int @default(0)

  moves      GameMove[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@index([coupleId, kind, status])
  /// Cho cron quét ván hết giờ.
  @@index([status, turnDeadlineAt])
  /// Cho cron huỷ ván bỏ dở.
  @@index([status, lastMoveAt])
  @@map("games")
}

/// Lịch sử nước đi. KHÔNG dùng để dựng lại ván (cột `state` đã đủ), mà để hiện
/// "nước vừa đánh", gỡ lỗi khi luật xử sai, và sau này làm màn phát lại.
model GameMove {
  id     BigInt @id @default(autoincrement())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Số thứ tự trong ván, bắt đầu từ 1.
  no Int
  /// Tiến lên: {cards:[...]} hoặc {pass:true}. Caro: {r,c}.
  payload Json
  /// Do đồng hồ tự sinh chứ không phải người bấm — giao diện nói rõ "hết giờ".
  auto      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([gameId, no])
  @@map("game_moves")
}

// ---------------------------------------------------------
// Phòng học chung (F12) — Pomodoro cho hai người
// ---------------------------------------------------------

/// Một phiên học. Đồng hồ là của SERVER: cả hai máy đọc chung `endsAt`, không
/// máy nào tự đếm giờ của mình.
///
/// Khác đồng hồ ván bài ở một điểm cốt lõi: đồng hồ này **không dừng** khi
/// người dùng khoá màn hình. Khoá máy để khỏi bị phân tâm chính là điều người
/// ta làm khi ngồi học — dừng đồng hồ lúc đó là phá đúng thứ đang phục vụ.
model StudySession {
  id          String      @id @default(uuid())
  coupleId    String
  couple      Couple      @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  startedById String
  startedBy   User        @relation("StudyStarter", fields: [startedById], references: [id], onDelete: Cascade)
  phase       StudyPhase  @default(FOCUS)
  status      StudyStatus @default(RUNNING)
  focusMin    Int         @default(25)
  breakMin    Int         @default(5)

  /// Mốc kết thúc chặng hiện tại.
  endsAt DateTime
  /// Số chặng HỌC đã hoàn thành (chặng nghỉ không tính).
  roundsDone Int @default(0)

  /// Ai đang ở trong phòng — mảng userId. Chỉ hai người nên để Json là đủ,
  /// cùng lý do với `Post.reactions`: tách bảng chỉ tốn thêm một lần join.
  presentUserIds Json @default("[]")

  logs       StudyLog[]
  startedAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@index([coupleId, status])
  /// Cho cron quét chặng đã hết giờ.
  @@index([status, endsAt])
  @@map("study_sessions")
}

/// Một chặng HỌC đã hoàn thành của một người. Chỉ ghi khi chặng FOCUS chạy hết
/// giờ — bỏ dở giữa chừng thì không tính, để con số thống kê nói đúng sự thật.
model StudyLog {
  id        BigInt        @id @default(autoincrement())
  coupleId  String
  couple    Couple        @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  session   StudySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  /// Chặng thứ mấy trong phiên. Cùng `sessionId` thì cặp (sessionId, round) là
  /// khoá tự nhiên của một chặng — nhờ nó mới đếm được "chặng nào cả hai cùng
  /// ngồi" mà không phải đoán bằng cách so mốc thời gian tạo bản ghi.
  round     Int
  minutes   Int

  /// Ngày lịch GIỜ VIỆT NAM, không phải ngày UTC. Chuỗi ngày học đếm theo cột
  /// này; lưu timestamp rồi so sau sẽ tính nhầm mọi buổi học sau nửa đêm
  /// (ADR 2026-09-07).
  day DateTime @db.Date

  createdAt DateTime @default(now())

  @@index([coupleId, userId, day])
  @@map("study_logs")
}
