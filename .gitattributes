# Trong repo LUÔN dùng LF, kể cả khi máy dev là Windows (core.autocrlf=true).
# Code này deploy lên VPS Linux và được COPY vào image Docker — file CRLF sẽ làm
# script shell chết với lỗi "bad interpreter: /bin/sh^M".
* text=auto eol=lf

# File chỉ chạy trên Windows thì giữ CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# File nhị phân: không đụng vào.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
