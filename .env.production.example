# =========================================================
# Beside — MẪU CẤU HÌNH CHO MÁY CHỦ THẬT (production)
#
#   Trên VPS:  cp .env.production.example .env  →  điền giá trị thật
#
# ⚠️ TUYỆT ĐỐI KHÔNG copy file .env của máy dev lên đây.
#    API có rào chắn: nếu phát hiện secret trông như giá trị để tạm hoặc
#    secret của máy dev, nó sẽ TỪ CHỐI KHỞI ĐỘNG và in ra biến nào sai.
#    Đó là chủ ý — thà chết lúc boot còn hơn chạy với token ai cũng đoán được.
# =========================================================

# ---------- Domain ----------
# Đổi 3 dòng này là đổi được toàn bộ hệ thống sang domain khác.
# COOKIE_DOMAIN phải KHỚP với host của APP_ORIGIN, nếu không người dùng
# đăng nhập xong sẽ bị đá ra ngay (API kiểm tra và báo lỗi lúc khởi động).
APP_DOMAIN=easytech.io.vn
APP_ORIGIN=https://easytech.io.vn
COOKIE_DOMAIN=easytech.io.vn

# Email nhận cảnh báo hết hạn chứng chỉ từ Let's Encrypt
ACME_EMAIL=email-that-cua-ban@vi-du.com

# ---------- PostgreSQL ----------
# Sinh mật khẩu:  openssl rand -base64 32
POSTGRES_USER=beside
POSTGRES_PASSWORD=
POSTGRES_DB=beside
# Trên VPS không có PostgreSQL nào khác nên để 5432. Chỉ bind 127.0.0.1.
POSTGRES_PORT=5432

# docker-compose TỰ GHI ĐÈ biến này để trỏ tới host "db" trong mạng Docker,
# nên giá trị ở đây chỉ dùng khi chạy lệnh Prisma thủ công trên VPS.
DATABASE_URL=

# ---------- Redis ----------
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_URL=

# ---------- API ----------
NODE_ENV=production
API_PORT=3000

# Sinh HAI giá trị KHÁC NHAU:  openssl rand -base64 48  (chạy 2 lần)
# Dùng chung một giá trị sẽ khiến access token có thể dùng làm refresh token.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
INVITE_TTL_HOURS=24

# KHÔNG khai báo CORS_EXTRA_ORIGINS ở production.
# Cho phép thêm origin http:// hoặc localhost là để hở cho trang khác gọi API
# kèm cookie của người dùng — API sẽ từ chối khởi động nếu thấy.

# ---------- Web (nhúng vào bundle lúc BUILD) ----------
# Đều là đường dẫn tương đối nên không phụ thuộc domain.
# Đổi domain thì vẫn phải build lại web, vì Vite nhúng biến vào lúc build.
VITE_API_BASE_URL=/api/v1
VITE_WS_PATH=/socket.io
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ---------- MinIO (Phase 3 — chưa dùng) ----------
# Endpoint MinIO. docker-compose tự ghi đè thành http://minio:9000 cho container api.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=beside-media
# Link ảnh có chữ ký sống bao lâu (giây)
S3_URL_TTL_SECONDS=3600

MINIO_ROOT_USER=beside
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=beside-media

# ---------------------------------------------------------
# Web Push (F7) — BẮT BUỘC sinh cặp khoá RIÊNG cho production.
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Không dùng lại khoá của môi trường dev.
# VAPID_SUBJECT phải là mailto: hoặc https: thật — dịch vụ đẩy của Apple/Google
# dùng nó để liên hệ khi server gửi sai.
# ---------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
