# =========================================================
# Beside — MẪU CẤU HÌNH CHO MÁY DEV (development)
#
#   cp .env.example .env
#
# File này CHỈ dành cho máy lập trình. Cấu hình cho máy chủ thật nằm ở
# .env.production.example — hai môi trường KHÔNG dùng chung file.
#
# Vì sao tách: nếu copy .env của máy dev lên VPS thì secret dev sẽ thành
# secret production. API có rào chắn từ chối khởi động trong trường hợp đó,
# nhưng tách file ngay từ đầu vẫn hơn.
#
# KHÔNG commit file .env (đã có trong .gitignore).
# =========================================================

# Giá trị dev cố tình để dễ đọc, dễ chia sẻ trong nhóm — KHÔNG phải secret thật.

# ---------- Domain khi chạy trên máy ----------
# `npm run dev:web` chạy ở cổng 5173 và tự proxy /api sang cổng 3000.
APP_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=localhost
# Cho phép gọi thẳng vào API khi gỡ lỗi. KHÔNG bao giờ khai biến này ở production.
CORS_EXTRA_ORIGINS=http://localhost:4173

# Chỉ có tác dụng khi chạy `npm run docker:up` — lớp phủ docker-compose.local.yml
# đã ghi đè thành localhost, nên giá trị ở đây không quan trọng.
APP_DOMAIN=localhost
ACME_EMAIL=dev@localhost

# ---------- PostgreSQL ----------
# Biến API thật sự dùng. Trong Docker, docker-compose tự ghi đè biến này
# để trỏ tới host "db", nên giá trị ở đây chỉ ảnh hưởng lúc chạy trên máy.
#
#   Dev trên máy, dùng PostgreSQL cài sẵn (khuyến nghị — nhanh, không tốn RAM):
#     tạo user/db một lần:
#       & "C:\Program Files\PostgreSQL\18\bin\psql.exe" -U postgres -f infra/postgres/local-setup.sql
DATABASE_URL=postgresql://beside:doi-gia-tri-nay-postgres@localhost:5432/beside?schema=public

# ---------- PostgreSQL trong Docker (chỉ dùng cho docker compose) ----------
POSTGRES_USER=beside
POSTGRES_PASSWORD=doi-gia-tri-nay-postgres
POSTGRES_DB=beside
# Chỉ bind 127.0.0.1, không phơi ra Internet.
# Trên máy Windows đã cài sẵn PostgreSQL thì cổng 5432 đã bị chiếm → dùng 55432.
POSTGRES_PORT=55432

# ---------- Redis ----------
REDIS_PASSWORD=doi-gia-tri-nay-redis
REDIS_PORT=6379
REDIS_URL=redis://:doi-gia-tri-nay-redis@localhost:6379

# ---------- API ----------
NODE_ENV=development
API_PORT=3000
# Bắt buộc >= 32 ký tự và hai giá trị phải KHÁC nhau.
# Ở máy dev cứ để nguyên cũng được; trên máy chủ thật thì bắt buộc sinh mới
# (openssl rand -base64 48) — API sẽ từ chối khởi động nếu thấy giá trị dev.
JWT_ACCESS_SECRET=dev_access_secret_khong_dung_cho_production_32
JWT_REFRESH_SECRET=dev_refresh_secret_khac_access_khong_dung_that_32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Mã ghép đôi hết hạn sau bao nhiêu giờ
INVITE_TTL_HOURS=24

# ---------- Web (biến build-time của Vite) ----------
VITE_API_BASE_URL=/api/v1
VITE_WS_PATH=/socket.io
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ---------- MinIO (Phase 3 — chưa dùng ở Phase 1) ----------
# Endpoint MinIO. docker-compose tự ghi đè thành http://minio:9000 cho container api.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=beside-media
# Link ảnh có chữ ký sống bao lâu (giây)
S3_URL_TTL_SECONDS=3600

MINIO_ROOT_USER=beside
MINIO_ROOT_PASSWORD=doi-gia-tri-nay-minio
MINIO_BUCKET=beside-media
